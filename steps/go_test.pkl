import "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"

/// Runs `go test ./...` in each Go workspace (a directory containing
/// `go.mod`).
go_test = new Config.Step {
  glob = "**/*.go"
  workspace_indicator = "go.mod"
  check = new Config.CommandSpec {
    command = "cd {{workspace}} && go test ./..."
    effect = "write"
  }
  tests {
    ["passes when tests pass"] {
      run = "check"
      tmpdir = true
      write {
        ["go.mod"] =
          """
            module example.com/test

            go 1.21
          """
        ["main.go"] =
          """
            package main

            func main() {}
          """
        ["main_test.go"] =
          """
            package main

            import "testing"

            func TestOK(t *testing.T) {}
          """
      }
      expect { code = 0 }
    }
    ["fails when a test fails"] {
      run = "check"
      tmpdir = true
      write {
        ["go.mod"] =
          """
            module example.com/test

            go 1.21
          """
        ["main.go"] =
          """
            package main

            func main() {}
          """
        ["main_test.go"] =
          """
            package main

            import "testing"

            func TestFail(t *testing.T) { t.Fatal("boom") }
          """
      }
      expect { code = 1 }
    }
  }
}
